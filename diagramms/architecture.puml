@startuml
title inspect_step Component Architecture

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "Operator" as Operator

package "Ansible Controller" {
  component "ansible-playbook" as CLI
  component "TaskQueueManager" as TQM
  component "PlayIterator" as Iterator
  component "linear\nStrategyModule" as Linear
  component "inspect_step\nStrategyModule" as Inspector
  component "Interactive Command Loop" as Prompt
  component "Watch and Breakpoint State" as DebugState
  component "Last Result Snapshot" as ResultState
  component "VariableManager" as Variables
  component "Templar" as Templar
  component "Task Executor Workers" as Workers
}

database "Inventory and Variable Sources" as Inventory
artifact "Playbooks, Roles, and Task Data" as Sources
artifact "Local Template Preview" as Preview
node "Managed Hosts" as Hosts

Operator --> CLI : starts with --step
Operator <--> Prompt : inspection commands
CLI --> TQM : run playbook
TQM --> Iterator : obtain host/task states
TQM --> Inspector : execute selected strategy
Linear <|-- Inspector
Inspector --> Prompt : task and host context
Inspector --> DebugState : manage watches, breakpoints, go, and no_log overrides
Inspector --> Variables : collect or update variables
Inspector --> Templar : template task arguments (normal lookups)
Inspector --> Templar : evaluate expression (lookups disabled)
Inspector --> Templar : explicit lookup evaluation (one host, warning)
Inspector --> Templar : expand loop items (normal lookups)
Templar --> Inspector : rendered content or value
Inspector --> Preview : template-save (mode 0600)
Inspector --> Workers : queue approved tasks or no_log-disabled copies
Inventory --> Variables
Sources --> Iterator
Sources --> Inspector : parsed task definition
Workers --> Hosts : execute modules
Workers --> TQM : task results
TQM --> Inspector : pending results and failures
Inspector --> ResultState : capture host results
ResultState --> Prompt : result / result!
Inspector --> Iterator : restore explicitly ignored failures
TQM --> Variables : facts and registered results

@enduml
